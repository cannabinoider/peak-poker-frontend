{
  "name": "peak-poker-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "pretty": "prettier --write .",
    "pretty-check": "prettier --check .",
    "test": "node --experimental-transform-types --no-warnings --test \"src/**/*.test.ts\"",
    "contracts:sync": "node scripts/contracts-sync.mjs",
    "contracts:check": "node scripts/contracts-sync.mjs --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix",
    "*.{ts,tsx,css,md,json,mjs}": "prettier --write"
  }
}
